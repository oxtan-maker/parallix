          "suppressions": [
            {
              "justification": "Test-only: `gone` is a fresh mkdtempSync path created in-process (not attacker input) and the executable is the pinned build artifact. Script forces a deterministic crash to exercise source maps. Array-form spawnSync with no shell."
            }
          ],
