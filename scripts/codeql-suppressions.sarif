                  "startColumn": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "js/shell-command-injection-from-environment",
          "suppressions": [
            {
              "justification": "spawnSync array form; the allowlisted launcher name is passed as positional $1, never interpolated into a shell string, so shell metacharacters cannot be interpreted. No injection surface."
            }
          ],
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/adapters/agents/launcher-selection.ts"
