      "results": [
        {
          "ruleId": "js/clear-text-logging",
          "suppressions": [
            {
              "justification": "Default logger forwards caller args to console; this is the logging framework, not a sensitive-data sink. No credential, token, or PII is routed through these delegates."
            }
          ],
          "locations": [
