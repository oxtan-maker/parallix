            }
          ]
        },
        {
          "ruleId": "js/missing-rate-limiting",
          "suppressions": [
            {
              "justification": "Host binds a loopback port for a single launch (ADR 0054) and is never reachable off 127.0.0.1, so there is no network-facing attacker to exhaust. Rate limiting a loopback single-tenant socket adds cost with no threat."
            }
          ],
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/interfaces/web/host.ts"
                },
                "region": {
                  "startLine": 241,
                  "startColumn": 1
                }
              }
            }
          ]
        },
        {
          "ruleId": "js/shell-command-injection-from-environment",
          "suppressions": [
            {
              "justification": "spawnSync array form runs with no shell; args pass directly to the git executable, so there is no command-injection surface. Args are internal trusted paths (repo root, config dirs), never user input."
            }
          ],
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/adapters/git/git.ts"
                },
                "region": {
