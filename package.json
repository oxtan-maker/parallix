{
  "name": "@magnusekdahl/parallix",
  "version": "1.5.60",
  "description": "AI mission workflow toolkit with a px CLI — local-first, human-in-the-loop multi-agent development",
  "license": "AGPL-3.0-or-later",
  "private": false,
  "type": "module",
  "bin": {
    "px": "build/px.mjs"
  },
  "engines": {
    "node": ">=22.23.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magnusekdahl/parallix.git"
  },
  "keywords": [
    "parallix",
    "workflow",
    "ai",
    "coding-agents",
    "multi-agent",
    "mission",
    "cli"
  ],
  "bugs": {
    "url": "https://github.com/magnusekdahl/parallix/issues"
  },
  "homepage": "https://github.com/magnusekdahl/parallix#readme",
  "files": [
    "NOTICES",
    "build/",
    "!build/sea",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run bundle",
    "build:web": "vite build --config web/vite.config.ts",
    "bundle": "tsx scripts/build-canonical-bundle.ts",
    "dev": "tsx src/entry/px.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test:package-content && npm audit --omit=dev",
    "test": "FORCE_COLOR=0 tsx test/run-default-tests.ts",
    "test:integration": "FORCE_COLOR=0 tsx test/run-default-tests.ts --integration",
    "test:package-content": "tsx scripts/package-content-audit.ts",
    "test:reproducible-output": "tsx scripts/verify-reproducible-build.ts",
    "test:coverage": "FORCE_COLOR=0 tsx src/adapters/verification/coverage-gate.ts --lcov",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.scripts.json",
    "test:bundle": "node --enable-source-maps build/px.mjs --version",
    "benchmark:runtime": "tsx scripts/benchmark-runtime.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.6"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@stryker-mutator/core": "^9.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.4",
    "fast-uri": "^3.1.6",
    "fastify": "^5.12.1",
    "ink": "^6.8.0",
    "postject": "^1.0.0-alpha.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.8",
    "sonarqube-scanner": "^5.0.0",
    "tsx": "4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
