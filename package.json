{
  "name": "@magnusekdahl/parallix",
  "version": "1.4.41",
  "description": "AI mission workflow toolkit with a px CLI — local-first, human-in-the-loop multi-agent development",
  "license": "AGPL-3.0-or-later",
  "private": false,
  "type": "module",
  "bin": {
    "px": "build/px.mjs"
  },
  "engines": {
    "node": ">=22.23.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magnusekdahl/parallix.git"
  },
  "keywords": [
    "parallix",
    "workflow",
    "ai",
    "coding-agents",
    "multi-agent",
    "mission",
    "cli"
  ],
  "bugs": {
    "url": "https://github.com/magnusekdahl/parallix/issues"
  },
  "homepage": "https://github.com/magnusekdahl/parallix#readme",
  "files": [
    "build/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "NOTICES"
  ],
  "scripts": {
    "build": "npm run bundle",
    "bundle": "node scripts/build-canonical-bundle.js",
    "dev": "tsx --import ./src/entry/esm-globals.ts src/entry/px.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test:package-content && npm audit --omit=dev",
    "test": "FORCE_COLOR=0 node test/run-default-tests.js",
    "test:integration": "FORCE_COLOR=0 node test/run-default-tests.js --integration",
    "test:package-content": "node scripts/package-content-audit.js",
    "test:reproducible-output": "node scripts/verify-reproducible-dist.js",
    "test:coverage": "FORCE_COLOR=0 node dist/lib/commands/coverage-gate.js --lcov",
    "typecheck": "tsc --noEmit",
    "test:bundle": "node --enable-source-maps build/px.mjs --version"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.6"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@stryker-mutator/core": "^9.6.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.4",
    "ink": "^6.8.0",
    "react": "^19.2.3",
    "sonarqube-scanner": "^5.0.0",
    "tsx": "4.20.6",
    "typescript": "^5.9.3"
  }
}
