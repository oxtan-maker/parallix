{
  "name": "@magnusekdahl/parallix",
  "version": "1.4.2",
  "description": "AI mission workflow toolkit with a px CLI — local-first, human-in-the-loop multi-agent development",
  "license": "AGPL-3.0-or-later",
  "private": false,
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "px": "dist/px.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magnusekdahl/parallix.git"
  },
  "keywords": [
    "parallix",
    "workflow",
    "ai",
    "coding-agents",
    "multi-agent",
    "mission",
    "cli"
  ],
  "bugs": {
    "url": "https://github.com/magnusekdahl/parallix/issues"
  },
  "homepage": "https://github.com/magnusekdahl/parallix#readme",
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "config/",
    "data/",
    "docs/",
    "examples/",
    "prompts/",
    "templates/",
    "tools/setup-forgejo-docker.sh"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx px.ts",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "FORCE_COLOR=0 node test/run-default-tests.js",
    "test:integration": "FORCE_COLOR=0 node test/run-default-tests.js --integration",
    "test:package-content": "node scripts/package-content-audit.js",
    "test:reproducible-output": "node scripts/verify-reproducible-dist.js",
    "test:coverage": "FORCE_COLOR=0 node dist/lib/commands/coverage-gate.js --lcov",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^9.39.4",
    "sonarqube-scanner": "^4.0.1",
    "tsx": "4.20.6",
    "typescript": "^5.9.3"
  }
}
