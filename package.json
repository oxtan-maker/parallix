{
  "name": "@magnusekdahl/parallix",
  "version": "1.5.328",
  "description": "Local-first workflow and trust layer for AI coding agents — isolated Git worktree missions, separate code review, repository-owned verification, Linux confinement, and human-owned merges",
  "license": "AGPL-3.0-or-later",
  "private": false,
  "type": "module",
  "bin": {
    "px": "build/px.mjs"
  },
  "engines": {
    "node": ">=22.23.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxtan-maker/parallix.git"
  },
  "keywords": [
    "parallix",
    "coding-agent",
    "ai-coding-agents",
    "agent-orchestration",
    "agent-harness",
    "git-worktree",
    "git-worktrees",
    "code-review",
    "verification",
    "local-first",
    "claude-code",
    "codex",
    "qwen-code",
    "mistral-vibe",
    "opencode",
    "pi-coding-agent"
  ],
  "bugs": {
    "url": "https://github.com/oxtan-maker/parallix/issues"
  },
  "homepage": "https://github.com/oxtan-maker/parallix#readme",
  "files": [
    "NOTICES",
    "build/",
    "!build/sea",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run bundle",
    "build:web": "node scripts/run-build-web.mjs",
    "bundle": "tsx scripts/build-canonical-bundle.ts",
    "dev": "tsx src/entry/px.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run test:package-content && npm audit --omit=dev",
    "test": "FORCE_COLOR=0 tsx test/run-default-tests.ts",
    "test:integration": "npm run build && npm run test:integration:prebuilt",
    "test:integration:prebuilt": "PARALLIX_PREBUILT_PACK=1 FORCE_COLOR=0 tsx test/run-default-tests.ts --integration",
    "test:integration:ci": "npm run build && npm run test:integration:ci:prebuilt",
    "test:integration:ci:prebuilt": "PARALLIX_PREBUILT_PACK=1 FORCE_COLOR=0 tsx test/run-default-tests.ts --integration-ci",
    "test:integration:ci:all:prebuilt": "PARALLIX_PREBUILT_PACK=1 FORCE_COLOR=0 tsx test/run-default-tests.ts --integration-ci-all",
    "test:integration:local": "FORCE_COLOR=0 tsx test/run-default-tests.ts --integration-local",
    "test:integration:local:prebuilt": "PARALLIX_PREBUILT_PACK=1 FORCE_COLOR=0 tsx test/run-default-tests.ts --integration-local",
    "test:agent-e2e": "node --import tsx --import ./test/bootstrap-e2e-parallix-home.ts test/e2e/agents/real-agent-smoke.test.ts",
    "test:lifecycle-e2e": "node --test --import tsx --import ./test/bootstrap-e2e-parallix-home.ts test/e2e/lifecycle/mission-lifecycle.test.ts",
    "test:jev-lifecycle-e2e": "node --test --import tsx --import ./test/bootstrap-e2e-parallix-home.ts test/e2e/lifecycle/repeat-review-classification.test.ts",
    "test:ci": "npm run typecheck && npm run build && npm test && npm run test:integration:ci:all:prebuilt && npm run test:bundle && npm run test:package-content:prebuilt",
    "test:package-content": "tsx scripts/package-content-audit.ts",
    "test:package-content:prebuilt": "PARALLIX_PREBUILT_PACK=1 tsx scripts/package-content-audit.ts",
    "test:codeql": "bash scripts/codeql-sast.sh",
    "test:reproducible-output": "tsx scripts/verify-reproducible-build.ts",
    "sonar": "tsx scripts/sonar-local.ts scan",
    "sonar:delete-branch": "tsx scripts/sonar-local.ts delete-branch",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.scripts.json",
    "test:bundle": "node --enable-source-maps build/px.mjs --version",
    "release:publish": "tsx scripts/release-publish.ts",
    "benchmark:runtime": "tsx scripts/benchmark-runtime.ts",
    "benchmark:web-reload": "tsx scripts/benchmark-web-reload.ts",
    "coverage:merge": "tsx scripts/coverage-merge.ts coverage/lcov.info coverage/.lcov-unit.info coverage/.lcov-integration-ci.info",
    "coverage:summary": "tsx scripts/render-lcov-summary.ts coverage/lcov.info",
    "docs:velocity:export": "tsx scripts/docs-velocity-export.ts",
    "docs:velocity:render": "tsx scripts/docs-velocity-render.ts",
    "docs:velocity:verify": "tsx scripts/docs-velocity-render.ts --verify"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.80.6 || ^1.0.2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "overrides": {
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.2",
    "@types/node": "^26.6.2",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.4",
    "fast-uri": "^4.2.1",
    "fastify": "^5.12.1",
    "happy-dom": "^20.14.5",
    "ink": "^6.8.0",
    "jevtok-ts": "0.2.0",
    "postject": "^1.0.0-alpha.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonar-scanner": "3.1.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0"
  }
}
