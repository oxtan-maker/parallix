{
  "gates": {
    "dependency-audit": {
      "command": "npm audit --audit-level=high",
      "order": 1,
      "run_last": false,
      "always": true
    },
    "build": {
      "command": "npm run build",
      "order": 2,
      "run_last": false,
      "always": true
    },
    "unit": {
      "command": "PARALLIX_FAST_UNIT=1 PARALLIX_TEST_COVERAGE=1 npm test -- --unit-test-headroom",
      "order": 3,
      "run_last": false,
      "always": true
    },
    "integration-ci": {
      "command": "PARALLIX_TEST_COVERAGE=1 npm run test:integration:ci:prebuilt",
      "order": 4,
      "run_last": false,
      "always": true
    },
    "integration-local": {
      "command": "npm run test:integration:local:prebuilt",
      "order": 5,
      "run_last": false,
      "always": true
    },
    "coverage-merge": {
      "command": "rm -f coverage/lcov.info && npm run coverage:merge && test -s coverage/lcov.info",
      "order": 6,
      "run_last": false,
      "always": true
    },
    "quality-gate": {
      "command": "npm run sonar",
      "order": 7,
      "run_last": false,
      "always": true
    },
    "workflow": {
      "command": "node --test --import tsx --import ./test/bootstrap-e2e-parallix-home.ts test/e2e/lifecycle/mission-lifecycle.test.ts",
      "order": 50,
      "run_last": true
    },
    "custom-agent-smoke": {
      "command": "node --import tsx --import ./test/bootstrap-e2e-parallix-home.ts test/e2e/agents/real-agent-smoke.test.ts",
      "order": 51,
      "run_last": true
    }
  }
}
