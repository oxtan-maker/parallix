{
  "gates": {
    "dependency-audit": {
      "command": "npm audit --audit-level=high",
      "order": 1,
      "run_last": false,
      "always": true
    },
    "build": {
      "command": "npm run build",
      "order": 2,
      "run_last": false,
      "always": true
    },
    "integration-suite": {
      "command": "npm run test:integration:prebuilt",
      "order": 3,
      "run_last": false,
      "always": true
    },
    "coverage": {
      "command": "rm -f coverage/lcov.info && PARALLIX_PREBUILT_PACK=1 npm run test:coverage -- --threshold 0 --lcov && test -s coverage/lcov.info",
      "order": 4,
      "run_last": false,
      "always": true
    },
    "quality-gate": {
      "command": "npm run sonar",
      "order": 5,
      "run_last": false,
      "always": true
    },
    "workflow": {
      "command": "node --import tsx --import ./test/bootstrap-e2e-parallix-home.ts test/e2e-mission-lifecycle.test.ts",
      "order": 50,
      "run_last": true
    },
    "custom-agent-smoke": {
      "command": "node --import tsx --import ./test/bootstrap-e2e-parallix-home.ts test/e2e-real-agent-smoke.test.ts",
      "order": 51,
      "run_last": true
    }
  }
}
