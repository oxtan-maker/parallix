{
  "gates": {
    "build": {
      "command": "npm run build",
      "order": 2,
      "run_last": false,
      "enabled": true,
      "areas": ["lib", "workflow"]
    },
    "integration-suite": {
      "command": "npm run test:integration",
      "order": 3,
      "run_last": false,
      "always": true
    },
    "workflow": {
      "command": "node --import tsx test/e2e-mission-lifecycle.test.ts",
      "order": 50,
      "run_last": true
    },
    "custom-agent-smoke": {
      "command": "node --import tsx test/e2e-real-agent-smoke.test.ts",
      "order": 51,
      "run_last": true
    }
  }
}
