{
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "skipLibCheck": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "resolveJsonModule": true
  },
  "include": [
    "test/**/*.js",
    "test/**/*.ts"
  ],
  "exclude": [
    "graphify-out/",
    ".forgejo-local/",
    "dist/"
  ]
}
