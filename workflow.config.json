{
  "product": {
    "name": "parallix"
  },
  "adapters": {
    "tasks": { "provider": "backlog-md", "storage": "backlog", "stateMap": "config/state-map.json" },
    "agents": {
      "maxConcurrentCustom": 2,
      "models": { "codex": "gpt-5.6-terra" },
      "runners": { "custom": "pi" },
      "subagents": { "maxParallel": 2 }
    },
    "missions": {
      "baseDir": "missions",
      "branchPrefix": "mission/",
      "worktreePattern": "../<repo>-<slug>"
    },
    "verification": { "command": "./scripts/verify-local.sh {{area}}", "defaultArea": "all" },
    "review": { "provider": "forgejo", "baseUrl": "http://localhost:3300", "remote": "review", "repo": "magnus/parallix" },
    "draft": { "preDraftCommand": "npm ci --no-audit --no-fund --prefer-offline" },
    "integrate": { "preCommitCommand": "./scripts/bump-version.sh", "postIntegrateCommand": "./scripts/refresh-global-px.sh && npm run sonar:delete-branch" },
    "gates": {
      "requirePreIntegration": true,
      "parallel": { "preIntegration": 6 },
      "preIntegration": [
        { "key": "build", "command": "npm run build", "order": 1 },
        { "key": "dependency-audit", "command": "npm audit --audit-level=high", "order": 2 },
        { "key": "verification", "command": "./scripts/verify-local.sh static-analysis", "order": 3, "reuse": "clean-tree" },
        { "key": "unit", "command": "PARALLIX_TEST_COVERAGE=1 npm test -- --unit-test-headroom", "order": 4, "after": ["build"] },
        { "key": "integration-ci", "command": "PARALLIX_TEST_COVERAGE=1 npm run test:integration:ci:prebuilt", "order": 5, "after": ["build"] },
        { "key": "integration-local", "command": "npm run test:integration:local", "order": 6, "after": ["build"] },
        { "key": "coverage-merge", "command": "rm -f coverage/lcov.info && npm run coverage:merge && test -s coverage/lcov.info", "order": 7, "after": ["unit", "integration-ci"] },
        { "key": "workflow", "command": "node --import tsx --import ./test/bootstrap-e2e-parallix-home.ts test/e2e-mission-lifecycle.test.ts", "order": 8, "after": ["build"] },
        { "key": "agent-smoke", "command": "node --import tsx --import ./test/bootstrap-e2e-parallix-home.ts test/e2e-real-agent-smoke.test.ts", "order": 9, "after": ["build"] },
        { "key": "quality-gate", "command": "npm run sonar", "order": 10, "after": ["coverage-merge"] }
      ]
    }
  }
}
