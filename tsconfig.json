{
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "noEmit": true,
    "declaration": false,
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "web/**/*.ts",
    "web/**/*.tsx",
    "web/**/*.d.ts"
  ],
  "exclude": [
    "test/",
    "graphify-out/",
    ".forgejo-local/",
    "dist/",
    "build/"
  ]
}
